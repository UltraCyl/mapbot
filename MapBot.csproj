<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>MapBot</AssemblyName>
    <RootNamespace>Default.MapBot</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- DPB_DIR should point to your DreamPoeBot installation directory -->
    <DPB_DIR Condition="'$(DPB_DIR)' == ''">$(MSBuildThisFileDirectory)..\..\DreamPoeBot</DPB_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DreamPoeBot.Loki">
      <HintPath>$(DPB_DIR)\DreamPoeBot.Loki.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(DPB_DIR)\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DPB_DIR)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="3rdParty\Default\MapBot\**\*.cs" />
    <Compile Include="3rdParty\Default\EXtensions\**\*.cs" />
    <EmbeddedResource Include="3rdParty\Default\MapBot\**\*.xaml" />
    <EmbeddedResource Include="3rdParty\Default\EXtensions\**\*.xaml" />
  </ItemGroup>

</Project>
